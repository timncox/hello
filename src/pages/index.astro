---
import { marked } from "marked";
import Base from "../layouts/Base.astro";
import { site, getPage } from "../site";
import "../styles/app.css";

const home = getPage("/") ?? site.pages[0];
const html = marked.parse(home.content) as string;
---
<Base title={home.title} description={site.site.description} pageSlug="/" bare>
  <div id="app">
    <header class="topbar">
      <a class="logo" href="#/">{site.site.name}</a>
      <nav class="tabs">
        <a href="#/" data-tab="feed">For You</a>
        <a href="#/books" data-tab="books">Books</a>
        <a href="#/themes" data-tab="themes">Themes</a>
        <a href="#/watch" data-tab="watch" aria-label="Watch">🎬</a>
        <a href="#/me" data-tab="me">❤️</a>
      </nav>
      <div class="stats" id="stats" title="Day streak · verses today"></div>
    </header>
    <main id="view">
      <div class="loading">Loading the Word…</div>
    </main>
    <div id="toast" role="status" aria-live="polite"></div>
  </div>
  <noscript>
    <div class="noscript"><article set:html={html} /></div>
  </noscript>
  <script src="../scripts/app.ts"></script>
</Base>
